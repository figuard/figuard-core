{
  "name": "figuard",
  "version": "0.1.0",
  "description": "FiGuard TypeScript SDK — pre-flight spend authorization for AI agents",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "homepage": "https://figuard.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figuard/figuard-core.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/figuard/figuard-core/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  },
  "keywords": [
    "ai",
    "agents",
    "spend",
    "authorization",
    "figuard",
    "mcp"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  }
}
