{
  "name": "figuard-mcp",
  "version": "1.1.2",
  "mcpName": "io.github.figuard/figuard-mcp",
  "description": "FiGuard MCP server — use FiGuard from Claude Code, Cursor, or Claude Desktop without writing SDK code",
  "main": "./dist/index.js",
  "bin": {
    "figuard-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "homepage": "https://figuard.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figuard/figuard-core.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/figuard/figuard-core/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^(.*)\\.js$": "$1"
    }
  },
  "keywords": [
    "mcp",
    "figuard",
    "ai",
    "agents",
    "spend",
    "authorization",
    "claude",
    "cursor"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "figuard": "^0.5.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.0.0"
  }
}
